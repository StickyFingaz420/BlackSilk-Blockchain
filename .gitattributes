# Deployment files run on Linux: always LF.
*.sh text eol=lf
*.service text eol=lf
Dockerfile text eol=lf

# Consensus-pinned artifacts (zkvm/guests/README.md): never converted.
# The ELFs are binary; the program id files keep their exact committed bytes.
*.elf binary
*.id -text

# Block stores kept as evidence (docs/evidence/labnet-w4-2026-09-30): binary.
docs/evidence/labnet-w4-*/runs/*/*.dat binary
