# Deployment files run on Linux: always LF.
*.sh text eol=lf
*.service text eol=lf
Dockerfile text eol=lf

# Consensus-pinned artifacts (zkvm/guests/README.md): never converted.
# The ELFs are binary; the program id files keep their exact committed bytes.
*.elf binary
*.id -text

# Block stores kept as evidence (docs/evidence/labnet-w4-2026-09-30): binary.
docs/evidence/labnet-w4-*/runs/*/*.dat binary

# Mutation evidence (docs/evidence/mutation-*): the filter (*.args) and test
# lists (*.tests) feed scripts that read one name per line; a checkout with
# CRLF endings made the names end in CR (RT-MUTD). Always LF.
docs/evidence/mutation-*/** text eol=lf

# The golden PX fixture (node/src/px_fixture.*, RT-PXR2 L2): consensus-pinned.
# The transaction is binary; the deploy's hex is LF on every checkout.
node/src/px_fixture.bin binary
node/src/px_fixture.txt text eol=lf

# Allow-listed third-party diffs (third-party-gate.sh): byte-compared, keep LF.
third_party/patches/*.patch text eol=lf
third_party/patches/*.sha256 text eol=lf
third_party/PRISTINE.sha256 text eol=lf
# Everything under third_party/ diffs as text, so no change hides behind
# "Binary files differ" (the gate rejects control bytes outside
# third_party/BINARY-ALLOWLIST; list allow-listed binaries here with -diff).
third_party/** diff
third_party/p3-batch-stark/tests/fixtures/*.postcard -diff
