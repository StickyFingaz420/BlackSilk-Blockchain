[Unit]
Description=BlackSilk node (testnet)
Documentation=https://github.com/StickyFingaz420/BlackSilk-Blockchain/blob/main/docs/testnet.md
After=network-online.target
Wants=network-online.target
# Crash-loop containment: at most 5 starts in 15 minutes (with RestartSec=30,
# about 2.5 minutes of failing starts). A transient failure (a port not yet
# free at boot, a full disk being cleaned) gets four retries; a deterministic
# one (a panic, exit 101, or exit 70 again at the same block) stops the unit
# instead of replaying the whole store for ever. Manual starts count too.
# The operator reads the log, then `systemctl reset-failed blacksilk-node`
# (docs/testnet.md §4.2, docs/testnet-incident-response.md). Statuses a
# restart cannot fix stop at once (RestartPreventExitStatus below).
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple
User=blacksilk
Group=blacksilk
ExecStart=/usr/local/bin/blacksilk-node --config /etc/blacksilk/node.toml
# Ctrl-C equivalent: lets the node save its peer table. (The node handles
# SIGTERM the same way.)
KillSignal=SIGINT
TimeoutStopSec=60
Restart=on-failure
RestartSec=30
# systemd 254 or later (not Debian 12's 252) can back off instead:
#   RestartSteps=5
#   RestartMaxDelaySec=300
# Exit status 65 (HALT_EXIT_CODE, node/src/lib.rs): a block that passed
# validation failed to apply. A restart replays into the same failure, so the
# node stays stopped for the operator (docs/testnet.md). Exit status 2: a
# configuration error, or a binary built with test-only code refusing the
# network (W4-GUARD); 66 (STORE_POW_EXIT_CODE): a stored proof-of-work hash
# its header does not produce; 71 (RANDOMX_SELF_TEST_EXIT_CODE): this build
# fails the RandomX self-test. A restart cannot help any of them.
RestartPreventExitStatus=2 65 66 71
LimitNOFILE=8192

# Hardening: the node needs its data directory and the network, nothing else.
StateDirectory=blacksilk
ReadWritePaths=/var/lib/blacksilk
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
