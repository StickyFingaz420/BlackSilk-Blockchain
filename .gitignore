# BlackSilk .gitignore
# Node
node_modules/
.next/
package-lock.json

# Rust
/target/
Cargo.lock

# OS
.DS_Store
Thumbs.db

# Build
RandomX/build/
RandomX/*.sln
RandomX/*.vcxproj*

# Logs
*.log
# Evidence logs are committed: the W4-LAB reports are regenerated from them.
!docs/evidence/labnet-w4-2026-09-30/runs/*/*.log
!docs/evidence/pow-pool-2026-10-01/logs/*.log

# Misc
*.tmp
*.swp
*.swo
*.bak
*.old
*.pyc
*.pyo
*.pyd
*.class
*.exe
*.dll
*.so
*.o
*.a
*.out
*.obj
*.vs/
*.vscode/
*.idea/
*.env
.env.*
# Ignore local config and secrets
secedit.jfm
secedit.sdb
# Ignore npm/yarn/pnpm lock files except root
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml
# Ignore test output
/coverage/
**/coverage/
# Ignore OS junk
ehthumbs.db
Icon?
# Ignore Rust build artifacts
**/Cargo.lock
!/Cargo.lock
# Tracked for reproducible builds: the consensus-pinned guests and the fuzz workspace.
!/zkvm/guests/Cargo.lock
!/fuzz/Cargo.lock
# The frozen Wasm contract research crate and its fuzz targets are their own
# workspaces (decision D22 "D-freeze"; contracts/README.md).
!/contracts/Cargo.lock
!/contracts/fuzz/Cargo.lock

# Claude Code local state and agent worktrees
.claude/

# The guest build's target directory (zkvm/guests/build.sh builds in place)
/zkvm/guests/target/
