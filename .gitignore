# BlackSilk .gitignore

# Rust build outputs. Unanchored, so a standalone `cargo build` inside any
# member or nested workspace (contracts/, fuzz/, tools/tpgate/, zkvm/guests/)
# never stages its target directory.
target/
Cargo.lock

# Other generated outputs: web/Wasm builds, profiling and debug data,
# cargo-mutants runs. No tracked file is one of these; an intended fixture
# would be added with `git add -f` and named in its README.
out/
dist/
*.wasm
*.pdb
*.profraw
*.profdata
perf.data*
flamegraph*.svg
mutants.out*/

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Icon?

# Logs
*.log
# Evidence logs are committed: reports are regenerated from them.
!docs/evidence/**/*.log

# Misc
*.tmp
*.swp
*.swo
*.bak
*.old
*.pyc
*.pyo
*.pyd
__pycache__/
*.class
*.exe
*.dll
*.so
*.o
*.a
*.out
*.obj
*.vs/
*.vscode/
*.idea/
*.env
.env.*

# Local node, wallet and lab data directories (never commit chain data or
# wallet files).
/data/
/blacksilk-data/
/labnet-data/
*.wallet
wallet.json

# Test output
/coverage/
**/coverage/

# Cargo.lock: only the root lock and the pinned workspaces below are tracked.
**/Cargo.lock
!/Cargo.lock
# Tracked for reproducible builds: the consensus-pinned guests and the fuzz workspace.
!/zkvm/guests/Cargo.lock
!/fuzz/Cargo.lock
# The frozen Wasm contract research crate and its fuzz targets are their own
# workspaces (decision D22 "D-freeze"; contracts/README.md).
!/contracts/Cargo.lock
!/contracts/fuzz/Cargo.lock
# The third-party gate's checker, built from a trusted revision (RT-TPGATE3).
!/tools/tpgate/Cargo.lock

# Claude Code local state and agent worktrees
.claude/
